NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Optional until the production domain is confirmed; enables article canonical URLs.
SITE_URL=https://news.ljhboard.cn
# Optional GA4 measurement ID; baked into the production build.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Server-only; must match the ingestion API's REVALIDATE_SECRET.
# REVALIDATE_SECRET=replace-with-a-random-secret
# Optional server-only publication integrations, enabled after production verification.
# SITE_URL must be the canonical HTTPS origin, without a path.
# CLOUDFLARE_API_TOKEN=zone-scoped-cache-purge-token
# CLOUDFLARE_ZONE_ID=your-32-character-zone-id
# INDEXNOW_KEY=your-8-to-128-character-alphanumeric-or-hyphen-key
# /indexnow.txt serves INDEXNOW_KEY publicly for host verification; use a dedicated value.
