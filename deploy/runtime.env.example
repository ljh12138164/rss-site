SITE_URL=https://news.ljhboard.cn
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
REVALIDATE_SECRET=replace-with-api-matching-secret
# Server-only application role; postgres is the Compose service name
DATABASE_URL=postgresql://rss_site_app:replace-with-app-role-password@postgres:5432/rss_site
CRON_SECRET=replace-with-api-matching-cron-secret
# Reuse the existing agent-service token and Vercel token from the old API
AGENT_SERVICE_TOKEN=replace-with-the-existing-agent-service-token
VERCEL_API_TOKEN=replace-with-the-existing-rsshub-vercel-token
# Base64-encoded 32-byte key; preserve independently for Cookie state recovery
MAINTENANCE_ENCRYPTION_KEY=replace-with-the-migration-generated-key
# compose.yaml supplies REDIS_URL=redis://redis:6379 on the private container network.
# Translation results expire 7 days after creation; Redis has no published port.
# Optional server-only integrations:
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# INDEXNOW_KEY=
