SITE_URL=https://news.ljhboard.cn
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
REVALIDATE_SECRET=replace-with-api-matching-secret
# compose.yaml supplies REDIS_URL=redis://redis:6379 on the private container network.
# Translation results expire 7 days after creation; Redis has no published port.
# Optional server-only integrations:
# Azure Translator resource must use F0 for the free monthly quota.
# Configuring a key skips local startup warmup; MTran loads on demand after Azure failure.
# AZURE_TRANSLATOR_KEY=your-translator-resource-key
# Required for regional resources; omit for a global resource.
# AZURE_TRANSLATOR_REGION=eastasia
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
# INDEXNOW_KEY=
