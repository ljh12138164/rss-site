DATABASE_URL=postgresql://postgres.project-ref:password@pooler-host:6543/postgres
CRON_SECRET=replace-with-a-random-secret
RSSHUB_BASE_URL=https://rsshub.app
# Optional Zhihu refresh: initial seed only; later values are encrypted in Supabase Vault.
# Include the cookie name: z_c0=value, or a full Cookie header value containing z_c0=value.
# ZHIHU_COOKIES=z_c0=replace-with-the-value-from-your-browser
# VERCEL_API_TOKEN=token-authorized-for-the-rsshub-project
# RSSHUB_VERCEL_PROJECT_ID=your-rsshub-project-id
# RSSHUB_VERCEL_TEAM_ID=your-vercel-team-id
# Optional: invalidate public list pages after a successful ingestion transaction.
# WEB_APP_URL=https://your-site.example
# REVALIDATE_SECRET=replace-with-the-same-web-server-secret
