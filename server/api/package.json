{
  "name": "@rss-site/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/local.ts",
    "dev:worker": "wrangler dev",
    "db:studio": "node --env-file=.env ./node_modules/drizzle-kit/bin.cjs studio --host=127.0.0.1",
    "build": "tsc --noEmit",
    "lint": "biome check .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "setup:cron": "tsx --env-file=.env src/setup/cli.ts",
    "ingest:ai-models": "tsx --env-file=.env src/ingestion/run-ai-models-ingest.ts",
    "publish:event": "tsx --env-file=.env src/technology/publish-event.ts",
    "cf-typegen": "wrangler types",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@rss-site/signals": "workspace:*",
    "drizzle-orm": "0.45.2",
    "fast-xml-parser": "5.11.1",
    "hono": "4.13.5",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.1",
    "@types/node": "26.4.1",
    "drizzle-kit": "0.31.10",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "5.0.0",
    "wrangler": "^4.130.0"
  }
}
